# Copy to .env.development.local / .env.staging.local / .env.production.local to override committed defaults.
# Vite only exposes variables prefixed with VITE_ to the client.

# REST API origin (trailing slash optional — normalized in src/config/env.js)
VITE_API_BASE_URL=https://api.crickbro.com/

# Socket.IO server (often same host as API; port may differ on staging)
VITE_SOCKET_URL=https://api.crickbro.com

# Public marketing site (used for default logo URL: {VITE_PUBLIC_SITE_URL}/logo.png)
VITE_PUBLIC_SITE_URL=https://crickbro.com

# Optional: full logo URL for Razorpay etc. (overrides VITE_PUBLIC_SITE_URL + /logo.png)
# VITE_LOGO_URL=https://crickbro.com/logo.png

VITE_CONTACT_EMAIL=info@crickbro.com
